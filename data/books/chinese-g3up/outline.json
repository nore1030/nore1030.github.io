            "写作"
          ]
        },
        {
          "name": "课文阅读与画面想象",
          "description": "边读边想象画面，理解《花的学校》中奇特的拟人化想象，感受童心与自然的联系。",
          "difficulty": 3,
          "question_types": [
            "阅读理解",
            "简答题"
          ]
        },
        {
          "name": "成语的构成与积累",
          "description": "观察并积累带有身体部位或动词构成的并列结构成语，如“摇头晃脑”、“张牙舞爪”。",
          "difficulty": 1,
          "question_types": [
            "连线/匹配",
            "填空"
          ]
        }
