  "knowledge": {
    "point": "叠词（ABB/AAB）的积累应用",
    "core_concept": "叠词是指通过词语重叠来增强表达效果的词汇。在一年级课文中，如“弯弯的、蓝蓝的、闪闪的”，这些叠词增加了语言的韵律感，使描写的事物更加生动形象。学生应掌握叠词与名词的合理搭配。",
    "key_formula": "特征重叠字 + 的 + 名词",
    "common_mistakes": [
      "搭配不当，如“圆圆的草芽”",
      "将“弯弯”写成“弯”"
    ],
    "tips": "结合课文画面记忆，比如看见月亮就想“弯弯”，看见星星就想“闪闪”。"
  }
