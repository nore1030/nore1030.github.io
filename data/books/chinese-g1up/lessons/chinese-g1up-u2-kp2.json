  "knowledge": {
    "point": "对韵歌与反义词辨析",
    "core_concept": "《对韵歌》和《金木水火土》展示了汉语特有的对仗美。通过“云对雨、雪对风、花对树、鸟对虫”的学习，学生能感知到自然界事物的对应性，同类事物的概念归并，以及词语在音节上的对称感。同时，学习“天与地、上与下”等反义词是低年级掌握词汇逻辑的关键。",
    "key_formula": "同类词，相对说，节奏感，记心头。",
    "common_mistakes": [
      "把“地”写成“池”或其他形近字",
      "分不清哪些词可以直接对应（如用“天”对“水”）"
    ],
    "tips": "可以采用师生对读、同桌拍手读的方式，在强烈的节奏中记忆韵文内容。"
  }
