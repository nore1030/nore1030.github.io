  "knowledge": {
    "point": "扇形统计图的特点",
    "core_concept": "扇形统计图用圆的面积表示总数量（通常记作1或100%），用圆内各个扇形的大小表示各部分数量占总数量的百分比。它能清晰地反映出部分与整体之间的关系，但不能直接看出具体的数值大小（除非结合总量计算）。",
    "key_formula": "各部分百分比之和 = 100\\%",
    "common_mistakes": [
      "误以为扇形统计图能直接看出数量的增减变化趋势（那是折线统计图的功能）。",
      "计算各部分百分比之和时不等于1（由于四舍五入或漏算其余部分）。"
    ],
    "tips": "观察扇形统计图时，先看总量是多少，再看最大的扇形是谁，这能帮你迅速抓住主要数据。"
  }
