  "knowledge": {
    "point": "百分数的意义与互化",
    "core_concept": "百分数表示一个数是另一个数的百分之几。它是专门用来表示两个数量之间的比率关系，因此不能带有单位。小数化百分数只要把小数点向右移两位并加百分号；分数化百分数通常先化成小数再化百分数。",
    "key_formula": "$百分数 = \\frac{比较量}{标准量} \\times 100\\%$",
    "common_mistakes": [
      "把百分数和分数的意义混淆，给百分数带上单位，如 50% 米。",
      "在互化过程中小数点移动位数错误，如将 0.03 写成 0.3%。"
    ],
    "tips": "记住百分数就是分母为100的特殊的比，它只表示‘关系’而不表示‘具体量’。"
  }
