  "knowledge": {
    "point": "小数与单位换算",
    "core_concept": "利用小数点移动规律处理单位换算。高级单位换低级单位（大变小）乘以进率；低级单位换高级单位（小变大）除以进率。",
    "key_formula": "\\text{高级单位} \\xrightarrow{\\times \\text{进率}} \\text{低级单位}",
    "common_mistakes": [
      "记错长度、面积、重量单位间的进率（如误记 1平方米=10平方分米）",
      "搞反乘除运算"
    ],
    "tips": "先看单位是变大还是变小，再想进率是多少，最后移小数点。"
  }
