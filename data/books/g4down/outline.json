            "选择"
          ]
        },
        {
          "name": "解决问题：租船/租车优化方案",
          "description": "在实际情境中利用除法余数处理和单价对比，寻找总价最省的资源分配方案。",
          "difficulty": 4,
          "question_types": [
            "应用题",
            "操作题"
          ]
