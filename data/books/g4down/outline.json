      "title": "四则运算",
      "knowledge_points": [
        {
          "name": "加、减法的意义和各部分间的关系",
          "description": "理解加减法互为逆运算，掌握‘加数+加数=和’及‘被减数-减数=差’的变形关系及验算方法。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "判断",
            "应用题"
          ]
        },
        {
          "name": "乘、除法的意义和各部分间的关系",
          "description": "理解乘除法互为逆运算，掌握‘因数×因数=积’及‘被除数÷除数=商’的变形关系，明确0不能作除数。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "选择",
            "计算题"
          ]
        },
        {
          "name": "带括号的四则混合运算顺序",
          "description": "掌握含有小括号和中括号的运算顺序，即先算小括号里面，再算中括号里面。",
