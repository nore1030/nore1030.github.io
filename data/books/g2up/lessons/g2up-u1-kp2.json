  "knowledge": {
    "point": "厘米的认识与使用",
    "core_concept": "厘米是测量较短物体长度的常用单位，可以用字母“cm”表示。测量时，要把刻度尺的“0”刻度对准物体的左端，观察物体右端对着刻度几，就是几厘米。",
    "key_formula": "长度 = 右端对应刻度 - 左端对应刻度",
    "common_mistakes": [
      "测量时从尺子的最边缘（没有刻度的地方）开始量",
      "没有对准0刻度，却直接读出右端的数值"
    ],
    "tips": "找找身体上的1厘米：食指的宽度大约就是1厘米。"
  }
