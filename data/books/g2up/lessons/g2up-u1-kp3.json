  "knowledge": {
    "point": "米的认识与单位换算",
    "core_concept": "米是比厘米大的长度单位，用于测量较长的物体。1米等于100个1厘米。在选择单位时，房子、树木、操场常用米；铅笔、橡皮、书本常用厘米。",
    "key_formula": "$1 米 = 100 厘米$",
    "common_mistakes": [
      "记混进率，认为1米等于10厘米",
      "在给物体填单位时，把米和厘米填反，如写出“大树高10厘米”"
    ],
    "tips": "张开双臂，两个手尖之间的距离大约就是1米。"
  }
