          "difficulty": 2,
          "question_types": [
            "选择",
            "判断",
            "规律探索"
          ]
        },
        {
          "name": "运动快慢的比较标准",
          "description": "掌握在相同距离下比时间、在相同时间内比距离的方法来衡量速度。",
          "difficulty": 3,
          "question_types": [
            "排序/比较",
            "应用题",
            "填空"
          ]
        }
      ],
      "examLessonId": "science-g3down-u1-exam",
      "examQuestionCount": 15
    },
