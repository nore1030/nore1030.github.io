      "title": "物体的运动",
      "knowledge_points": [
        {
          "name": "参照物与运动状态判断",
          "description": "通过选择参照物来判断物体是运动还是静止的，理解运动的相对性。",
          "difficulty": 1,
          "question_types": [
            "判断",
            "选择",
            "填空"
          ]
        },
        {
          "name": "位置的描述（方向与距离）",
          "description": "学会利用方向和距离两个要素准确描述物体在空间中的相对位置。",
          "difficulty": 2,
          "question_types": [
            "操作题",
            "填空",
            "画图"
          ]
        },
        {
          "name": "运动轨迹的分类（直线与曲线）",
          "description": "根据物体运动路径的形状，将其划分为直线运动和曲线运动。",
          "difficulty": 1,
          "question_types": [
            "判断",
            "选择",
            "连线/匹配"
          ]
        },
        {
          "name": "物体在斜面上的运动方式",
