  "knowledge": {
    "point": "函数与变量",
    "core_concept": "在一个变化过程中有两个变量 $x$、$y$，对 $x$ 的每一个确定值，$y$ 都有唯一确定的值与之对应，则 $y$ 是 $x$ 的函数。",
    "key_formula": "$y=f(x)$",
    "common_mistakes": [
      "把“唯一确定”忽略。"
    ],
    "tips": "看每个 $x$ 是否只对应一个 $y$。"
