{
  "textbook": "四年级上册",
  "units": [
    {
      "unit_number": 1,
      "title": "声音",
      "knowledge_points": [
        {
          "name": "声音的产生与描述",
          "description": "认识声音的多样性，理解声音是由物体振动产生的，并能用高、低、强、弱等词汇描述声音。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "选择",
            "连线/匹配"
          ]
        },
        {
          "name": "声音的传播介质",
          "description": "理解声音需要在气体、液体、固体中传播，真空不能传声，不同介质传声效果不同。",
          "difficulty": 2,
          "question_types": [
            "判断",
            "选择",
            "填空"
          ]
        },
        {
          "name": "人耳的结构与听觉形成",
          "description": "识别人耳的主要结构（耳廓、鼓膜、听小骨等），理解声波转化为听觉信号的过程。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "选择",
            "操作题"
          ]
        },
        {
          "name": "音量与音高的变化规律",
          "description": "探究振幅决定声音强弱（音量），振动频率（快慢）决定声音高低（音高）。",
          "difficulty": 4,
          "question_types": [
            "填空",
            "规律探索",
            "实验分析题"
          ]
        },
        {
          "name": "弦乐器的音高控制",
          "description": "通过改变弦的长度、松紧来调节音高的连续变化，并尝试设计制作小乐器。",
          "difficulty": 5,
          "question_types": [
            "操作题",
            "规律探索",
            "应用题"
          ]
        }
      ],
      "examLessonId": "science-g4up-u1-exam",
      "examQuestionCount": 15
    },
    {
      "unit_number": 2,
      "title": "呼吸与消化",
      "knowledge_points": [
        {
          "name": "人体呼吸系统与过程",
          "description": "认识肺、气管、膈肌等呼吸器官，理解吸气与呼气时胸腔与腹部的变化及气体交换。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "判断",
            "操作题"
          ]
        },
        {
          "name": "测量与提升肺活量",
          "description": "定义肺活量并掌握其测量方法，理解肺活量作为健康指标的意义及体育锻炼的作用。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "选择",
            "排序/比较"
          ]
        },
        {
          "name": "食物的分类与统计",
          "description": "按来源（动植物）、生熟、主辅等不同标准对一天的食物进行分类记录。",
          "difficulty": 1,
          "question_types": [
            "填空",
            "连线/匹配",
            "操作题"
          ]
        },
        {
          "name": "食物中的营养成分及其检测",
          "description": "辨识蛋白质、脂肪、糖类等营养，掌握利用碘酒检测淀粉和白纸压印检测脂肪的方法。",
          "difficulty": 3,
          "question_types": [
            "选择",
            "判断",
            "操作题"
          ]
        },
        {
          "name": "平衡膳食宝塔的应用",
          "description": "理解营养均衡的重要性，能参照膳食宝塔评估并设计合理的饮食方案。",
          "difficulty": 4,
          "question_types": [
            "应用题",
            "选择",
            "填空"
          ]
        },
        {
          "name": "口腔的消化功能",
          "description": "认识门齿、犬齿、臼齿的不同功能，理解牙齿对食物的初步物理消化作用。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "连线/匹配",
            "选择"
          ]
        }
      ],
      "examLessonId": "science-g4up-u2-exam",
      "examQuestionCount": 15
    },
    {
      "unit_number": 3,
      "title": "运动和力",
      "knowledge_points": [
        {
          "name": "重力与拉力对运动的影响",
          "description": "探究拉力大小（垫圈数量）与小车运动速度之间的关系，理解力可以改变物体运动状态。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "规律探索",
            "应用题"
          ]
        },
        {
          "name": "反冲力的应用与气球小车",
          "description": "认识反冲力现象，通过喷气方向与运动方向的相反性探究气球驱动小车的原理。",
          "difficulty": 3,
          "question_types": [
            "选择",
            "画图",
            "实验分析题"
          ]
        },
        {
          "name": "弹力与弹簧测力计的使用",
          "description": "理解弹力的定义，掌握弹簧测力计的结构、力的单位（牛顿）及测量方法。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "选择",
            "操作题"
          ]
        },
        {
          "name": "摩擦力的产生与增减",
          "description": "理解物体接触面产生的阻碍力，探究通过改变接触面、变滑动为滚动等方法减小摩擦。",
          "difficulty": 4,
          "question_types": [
            "选择",
            "判断",
            "规律探索"
          ]
        },
        {
          "name": "能量与运动速度的关系",
          "description": "通过撞击实验理解运动物体具有能量，且速度越快能量越大。",
          "difficulty": 4,
          "question_types": [
            "实验分析题",
            "填空",
            "排序/比较"
          ]
        },
        {
          "name": "动力小车的设计与迭代",
          "description": "遵循工程设计流程（明确问题-方案-实施-改进），协作完成动力小车的制作与评估。",
          "difficulty": 5,
          "question_types": [
            "操作题",
            "应用题",
            "规律探索"
          ]
        }
      ],
      "examLessonId": "science-g4up-u3-exam",
      "examQuestionCount": 15
    }
