  "knowledge": {
    "point": "多步实际问题的解决",
    "core_concept": "学会从文字中提取关键信息，区分“前、后、左、右”的位置关系。处理排队问题时，要注意“包含”和“不包含”目标本人的情况。理解“增加了、又来了”用加法，“飞走了、吃掉了”用减法。",
    "key_formula": "总人数 = 前面人数 + 后面人数 + 1（自己）",
    "common_mistakes": [
      "排队问题漏加自己：如计算前后总共人数时直接加数字",
      "不理解“捉迷藏”模型：忽略捉迷藏中必须有1个人是寻找者"
    ],
    "tips": "遇到排队题，养成动笔画小圆圈代表人的好习惯，防止漏算或多算。"
