{
  "textbook": "五年级下册",
  "units": [
    {
      "unit_number": 1,
      "title": "生物与环境",
      "knowledge_points": [
        {
          "name": "种子发芽的对比实验设计",
          "description": "掌握对比实验中控制变量的方法，确保除研究因素外其他条件完全相同，并设置多粒种子减少偶然性。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "实验设计题",
            "判断"
          ]
        },
        {
          "name": "种子发芽实验的数据分析与结论",
          "description": "通过班级记录表中的样本数据，分析温度、光照、水分对种子发芽的影响，归纳基本外部条件。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "分析题",
            "排序/比较"
          ]
        },
        {
          "name": "植物生长对光照的需求与光合作用",
          "description": "理解阳光是植物生长的重要条件，掌握植物利用二氧化碳、水和阳光制造养料并释放氧气的过程。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "选择",
            "判断"
          ]
        },
        {
          "name": "动物对环境的选择性（蚯蚓实验）",
          "description": "探究蚯蚓对光照和水分的选择，理解不同生物对阴暗、潮湿等特定环境的适应性。",
          "difficulty": 3,
          "question_types": [
            "实验设计题",
            "选择",
            "操作题"
          ]
        },
        {
          "name": "生物对环境改变的适应行为",
          "description": "了解季节更替时，生物通过迁徙、冬眠、产卵等行为变化来适应环境变化的生存策略。",
          "difficulty": 2,
          "question_types": [
            "连线/匹配",
            "选择",
            "填空"
          ]
        },
        {
          "name": "食物链与食物网的构建",
          "description": "描述生物间捕食关系，掌握箭头由被食者指向捕食者的书写规范，并在复杂情境中提取食物网。",
          "difficulty": 3,
          "question_types": [
            "画图",
            "填空",
            "应用题"
          ]
        },
        {
          "name": "生态系统的定义与生态瓶制作",
          "description": "认识群落与生态系统的概念，设计包含生产者、消费者和非生物环境的稳定微型生态系统。",
          "difficulty": 4,
          "question_types": [
            "操作题",
            "分析题",
            "应用题"
          ]
        }
      ],
      "examLessonId": "science-g5down-u1-exam",
      "examQuestionCount": 15
    },
    {
      "unit_number": 2,
      "title": "船的研究",
      "knowledge_points": [
        {
          "name": "船的历史、动力演变与结构优化",
          "description": "了解从人力、风力到机械动力的进化史，认识流线型船体减小阻力、宽大船体增加稳定性的原理。",
          "difficulty": 2,
          "question_types": [
            "选择",
            "分析题",
            "排序/比较"
          ]
        },
        {
          "name": "用沉的材料造船与浮力原理",
          "description": "探究通过改变物体形状（做成船型）增大排开水的体积，从而使下沉材料获得更大浮力并漂浮。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "实验设计题",
            "分析题"
          ]
        },
        {
          "name": "增加船的载重量及其影响因素",
          "description": "研究船的底面积及体积对载重量的影响，理解船的稳定性受形状和重心位置的影响。",
          "difficulty": 3,
          "question_types": [
            "填空",
            "应用题",
            "操作题"
          ]
        },
        {
          "name": "船的动力系统与方向控制装置",
          "description": "认识风帆、电力螺旋桨、喷气装置等动力形式，掌握船舵控制航行方向的作用。",
          "difficulty": 2,
          "question_types": [
            "连线/匹配",
            "选择",
            "操作题"
          ]
        },
        {
          "name": "工程设计流程：设计、制作与测试小船",
          "description": "经历需求分析、方案制订、制作原型、测试与迭代优化的完整工程流程，考虑成本与稳定性。",
          "difficulty": 5,
          "question_types": [
            "画图",
            "规律探索",
            "分析题"
          ]
        }
      ],
      "examLessonId": "science-g5down-u2-exam",
      "examQuestionCount": 15
    },
    {
      "unit_number": 3,
      "title": "环境与我们",
      "knowledge_points": [
        {
          "name": "人类活动引发的环境问题及后果",
          "description": "识记大气污染、水污染、噪音污染和固体废弃物污染的成因及其对人类健康和生态的连锁反应。",
          "difficulty": 2,
          "question_types": [
            "连线/匹配",
            "填空",
            "选择"
          ]
        },
        {
          "name": "地球水资源分布与淡水危机",
          "description": "通过饼图和条形图分析地球咸淡水比例，认识可利用淡水的稀缺性及人均水资源的不均衡性。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "分析题",
            "排序/比较"
          ]
        },
        {
          "name": "珍惜水资源与农业滴灌技术",
          "description": "掌握生活节水措施，理解滴灌技术通过管道精准灌溉植被根部以节约用水的科学原理。",
          "difficulty": 2,
          "question_types": [
            "应用题",
            "选择",
            "判断"
          ]
        },
        {
          "name": "垃圾的分类、减量与资源化利用",
          "description": "掌握四类垃圾分类标准（可回收、有害、厨余、其他），理解Reduce、Recycle、Harmless原则。",
          "difficulty": 3,
          "question_types": [
            "选择",
            "应用题",
            "分析题"
          ]
        },
        {
          "name": "温室效应模拟实验与能源利用",
          "description": "通过对比实验探究温室气体导致升温的原理，探讨化石能源对环境的影响及新能源开发的必要性。",
          "difficulty": 4,
          "question_types": [
            "实验设计题",
            "规律探索",
            "分析题"
          ]
        },
        {
          "name": "分析实际环境问题的多元决策",
          "description": "以湖泊治理为例，学会从渔民、开发商等多方利益主体立场出发，平衡经济与环保提出行动计划。",
          "difficulty": 5,
          "question_types": [
            "分析题",
            "应用题"
          ]
        }
      ],
      "examLessonId": "science-g5down-u3-exam",
      "examQuestionCount": 15
    },
    {
      "unit_number": 4,
      "title": "热",
      "knowledge_points": [
        {
          "name": "水的状态变化与温度关系",
          "description": "探究水在加热和冷却过程中的温度变化趋势，观察沸腾现象及撤去热源后的温度表现。",
          "difficulty": 3,
          "question_types": [
            "规律探索",
            "填空",
            "操作题"
          ]
        },
        {
          "name": "水的蒸发与凝结中的能量传递",
          "description": "理解蒸发吸热和凝结放热的过程，探究降低温度如何加速水蒸气凝结成小水滴。",
          "difficulty": 2,
          "question_types": [
            "填空",
            "应用题",
            "分析题"
          ]
        },
        {
          "name": "热传导：热在金属中的传递规律",
          "description": "通过实验观察热量从高温端向低温端、从热源中心向四周传递的方向性，认识热的良导体与不良导体。",
          "difficulty": 3,
          "question_types": [
            "判断",
            "实验设计题",
            "选择"
          ]
        },
        {
          "name": "热在液体和气体中的对流现象",
          "description": "通过示踪剂观察液体受热后上升、冷却后下降的循环流动过程，理解热对流的传递机制。",
          "difficulty": 3,
          "question_types": [
            "分析题",
            "填空",
            "操作题"
          ]
        },
        {
          "name": "保温杯的设计原理（减缓热传递）",
          "description": "综合运用传导、对流和辐射知识，通过选择材料和结构优化（如真空层、镀银等）减缓热量散失。",
          "difficulty": 4,
          "question_types": [
            "分析题",
            "实验设计题",
            "应用题"
          ]
        }
      ],
      "examLessonId": "science-g5down-u4-exam",
      "examQuestionCount": 15
    }
  ],
