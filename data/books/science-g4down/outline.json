      "title": "植物的生长变化",
      "knowledge_points": [
        {
          "name": "种子的外部特征与结构",
          "description": "观察描述种子形态，识别种皮、胚（胚根、胚芽、子叶）并理解其生命功能",
          "difficulty": 2,
          "question_types": [
            "填空",
            "选择",
            "判断",
            "连线/匹配"
          ]
        },
        {
          "name": "种植活动与生长观察记录",
          "description": "掌握科学种植步骤，使用种植杯观察萌发过程并制定长期定量的观察计划",
          "difficulty": 3,
          "question_types": [
            "操作题",
            "填空",
            "规律探索"
          ]
        },
        {
          "name": "根、茎、叶的生理功能",
          "description": "理解根的吸收固定作用、茎的运输作用及叶的光合与蒸腾作用，掌握对照实验设计",
          "difficulty": 3,
          "question_types": [
            "判断",
            "选择",
            "应用题"
          ]
        },
        {
          "name": "花、果实和种子的发育与传播",
          "description": "识别花的主要构造，理解传粉结实过程及四种主要的种子传播方式（风、水、动、弹）",
          "difficulty": 2,
          "question_types": [
            "连线/匹配",
            "选择",
            "填空"
          ]
        },
        {
          "name": "植物的生命周期与环境需求",
          "description": "梳理植物从种子到枯萎的全过程，分析生长所需的阳光、水分、温度等外部条件",
          "difficulty": 3,
          "question_types": [
            "填空",
            "排序/比较",
            "应用题"
          ]
        }
      ],
