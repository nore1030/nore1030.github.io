  "knowledge": {
    "point": "分数与除法的关系",
    "core_concept": "分数的分子相当于除法中的被除数，分母相当于除数，分数线相当于除号。这种关系可以表示为 $a \\div b = \\frac{a}{b}$（$b \\neq 0$）。要注意分数是一种数，而除法是一种运算。",
    "key_formula": "$被除数 \\div 除数 = \\frac{被除数}{除数}$",
    "common_mistakes": [
      "颠倒被除数和除数的位置，例如 2 除以 5 写成 5/2",
      "忘记除数（分母）不能为 0"
    ],
    "tips": "求“每份是多少”带单位，求“占全长的几分之几”不带单位。"
  }
