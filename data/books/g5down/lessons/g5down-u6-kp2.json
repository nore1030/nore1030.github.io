  "knowledge": {
    "point": "异分母分数加、减法",
    "core_concept": "异分母分数的分母不同，意味着它们的分数单位不同。就像“3个苹果”和“2个梨”不能直接说成“5个苹果”一样，必须先通过通分，把它们转化成相同分母（即相同分数单位）的分数，然后再按照同分母分数的规则计算。",
    "key_formula": "$\\frac{a}{b} \\pm \\frac{c}{d} = \\frac{ad \\pm bc}{bd}$",
    "common_mistakes": [
      "不通分直接把分子加分子，分母加分母。",
      "通分时只把分母扩大倍数，分子忘记对应扩大倍数。"
    ],
    "tips": "找公分母时，通常找分母们的最小公倍数，这样计算量最小。"
