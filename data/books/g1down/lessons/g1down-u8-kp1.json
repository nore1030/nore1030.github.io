  "knowledge": {
    "point": "100以内加减法综合运算技能",
    "core_concept": "100以内的加减法是数学学习的基础。主要分为：整十数加减整十数（直接加减十位）、两位数加一位数（注意进位，个位满十向十位进一）、两位数减一位数（注意退位，个位不够减从十位借一当十）。同时，要掌握小括号的使用规则，即‘先算括号里的’。",
    "key_formula": "$ \text{个数相加满十} \rightarrow \text{十位加一}; \text{个位不够减} \rightarrow \text{向十位借一作十} $",
    "common_mistakes": [
      "进位加法时忘记在十位上加 1",
      "退位减法时忘记在十位上减去借走的那 1 个十"
    ],
    "tips": "计算进位退位时，可以在数字上面点个小圆点或写个小 1，帮助记忆。多练习凑十法和破十法。"
  }
