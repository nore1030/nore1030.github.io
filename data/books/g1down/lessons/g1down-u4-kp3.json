  "knowledge": {
    "point": "100以内数的大小比较与描述",
    "core_concept": "比较两位数大小，先看十位，十位大的数就大；十位相同，再看个位。可以用“多一些、少一些（差距小）”和“多得多、少得多（差距大）”来描述关系。",
    "key_formula": "比较规则：十位不同看十位，十位相同看个位。",
    "common_mistakes": [
      "看到个位数字大就认为这个数大，如认为49小于39。",
      "分不清“多一些”和“多得多”的区别。"
    ],
    "tips": "把数看成钱，50元比10元多得多，而12元只比10元多一些。"
  }
