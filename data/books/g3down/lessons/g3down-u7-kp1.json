  "knowledge": {
    "point": "小数的读写法与含义",
    "core_concept": "小数是分数的另一种表现形式。十分之几可以写成一位小数，百分之几写成两位小数。读小数时，整数部分按整数读法，点读作“点”，小数部分按顺序读出每个数字。在长度单位中，1分米=0.1米；在人民币单位中，1角=0.1元。",
    "key_formula": "1\\text{分米} = 0.1\\text{米}, 1\\text{角} = 0.1\\text{元}",
    "common_mistakes": [
      "读小数部分时带上计数单位，如 0.25 误读作零点二十五",
      "混淆单位换算，如把 5 厘米直接写成 0.5 米"
    ],
    "tips": "记准小数点是分界线，左边是整数，右边第一位是十分位，表示几个十分之一。"
  }
