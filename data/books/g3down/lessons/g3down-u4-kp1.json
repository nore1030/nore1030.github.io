  "knowledge": {
    "point": "口算乘法",
    "core_concept": "掌握两位数、几百几十数乘一位数（进位）以及两位数乘整十、整百数的口算方法。口算时，先用因数中 0 前面的数相乘，然后看因数末尾共有几个 0，就在积的末尾添上几个 0。",
    "key_formula": "$a0 \times b0 = (a \times b) \times 100$",
    "common_mistakes": [
      "少算积末尾的 0（如 $40 \times 50$ 算成 200）",
      "进位时计算错误（如 $14 \times 3$ 算成 32）"
    ],
    "tips": "先乘非零数，末尾加 0 法。进位要记牢，细心不失分。"
  }
