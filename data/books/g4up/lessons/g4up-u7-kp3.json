  "knowledge": {
    "point": "统计图的数据分析",
    "core_concept": "统计的最终目的是为了解决问题。通过观察直条的高低对比，我们可以快速找出最大值、最小值、总数以及各项目之间的倍数关系，进而对现实情况做出合理的判断和建议（如销量预测、座位安排等）。",
    "key_formula": "总数 = 各项目数值之和；差额 = 最大值 - 最小值",
    "common_mistakes": [
      "读图不仔细，误把纵轴的一个刻度单位看错。",
      "进行预测或建议时脱离了数据事实，仅凭个人喜好回答。"
    ],
    "tips": "看图时先看纵轴单位，再看横轴项目，最后把直条对应的数字标注在旁边再开始计算。"
  }
