  "knowledge": {
    "point": "角的分类与画角",
    "core_concept": "根据度数分类：锐角（$<90^{\\circ}$）、直角（$=90^{\\circ}$）、钝角（$90^{\\circ}<角<180^{\\circ}$）、平角（$=180^{\\circ}$）、周角（$=360^{\\circ}$）。画角时先定线，再定点，连线即成。",
    "key_formula": "$1\\text{周角} = 2\\text{平角} = 4\\text{直角}$",
    "common_mistakes": [
      "认为大于 $90^{\\circ}$ 的角全是钝角，忽略了平角和周角",
      "分不清平角和直线、周角和射线的区别"
    ],
    "tips": "口诀：小于90是锐角，等于90是直角，90至180是钝角，180是平，360是周。"
  }
